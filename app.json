{
  "expo": {
    "name": "Meu Kumbo",
    "slug": "ab-finance",
    "version": "1.0.1",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/65313746-67bc-4bf4-93b1-0bcfd7dbdc48",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EDEDED",
    "primaryColor": "#9C32D7",
    "scheme": "abfinance",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.bachira242.abfinance",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bachira242.abfinance",
      "versionCode": 5,
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EDEDED"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDEDED",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#5B8DFF",
          "defaultChannel": "bills",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65313746-67bc-4bf4-93b1-0bcfd7dbdc48"
      }
    }
  }
}
